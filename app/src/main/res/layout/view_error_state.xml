<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutErrorState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xxl">

    <ImageView
        android:id="@+id/ivErrorIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/desc_error_state"
        android:padding="@dimen/space_lg"
        android:src="@drawable/ic_error_outline"
        app:tint="@color/colorError" />

    <TextView
        android:id="@+id/tvErrorTitle"
        style="@style/TextAppearance.ECommerce.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:text="@string/error_loading_title" />

    <TextView
        android:id="@+id/tvErrorSubtitle"
        style="@style/TextAppearance.ECommerce.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:maxWidth="280dp"
        android:text="@string/error_loading_subtitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.ECommerce.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height_small"
        android:layout_marginTop="@dimen/space_xl"
        android:paddingHorizontal="@dimen/space_xl"
        android:text="@string/action_retry" />

</LinearLayout>

