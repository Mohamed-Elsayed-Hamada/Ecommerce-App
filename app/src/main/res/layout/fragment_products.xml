<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/productsFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".presentation.products.ProductsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="@dimen/space_sm">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/iv_back"
                style="@style/Widget.ECommerce.IconButton.Circle"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorOnSurface"
                android:contentDescription="@string/action_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.ECommerce.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:gravity="center"
                android:text="@string/title_products"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_filter"
                app:layout_constraintStart_toEndOf="@id/iv_back"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Filter Button -->
            <ImageButton
                android:id="@+id/btn_filter"
                style="@style/Widget.ECommerce.IconButton.Circle"
                android:src="@drawable/ic_filter"
                app:tint="@color/colorOnSurface"
                android:contentDescription="@string/desc_filter_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.ECommerce.TextInputLayout.Search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_sm"
            android:hint="@string/search_products_hint"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/searchicon">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingVertical="@dimen/space_md"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Active Filter / Sort Row -->
        <LinearLayout
            android:id="@+id/filterSortContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Filter Status Text -->
            <TextView
                android:id="@+id/tv_filter_status"
                style="@style/TextAppearance.ECommerce.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/all_products" />

            <!-- Sort Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort"
                style="@style/Widget.ECommerce.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_sort"
                app:icon="@drawable/ic_sort"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_xs"
                app:iconTint="@color/colorPrimary" />

        </LinearLayout>

        <!-- FrameLayout for Products Grid & Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Products RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_products"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_md"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="6"
                tools:listitem="@layout/product_item" />

            <!-- Empty State -->
            <include
                android:id="@+id/layoutEmpty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Error State -->
            <include
                android:id="@+id/layoutError"
                layout="@layout/view_error_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Pagination Progress -->
        <ProgressBar
            android:id="@+id/paginationProgressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/space_sm"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

        <!-- Last Page Text -->
        <TextView
            android:id="@+id/lastPage"
            style="@style/TextAppearance.ECommerce.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_md"
            android:text="@string/no_more_products"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Initial Loading Progress -->
    <ProgressBar
        android:id="@+id/initialProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />

</FrameLayout>
