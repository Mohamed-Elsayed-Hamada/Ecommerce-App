<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    tools:context=".presentation.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xxl">

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.ECommerce.TextInputLayout.Search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:hint="@string/search_hint"
            app:layout_constraintEnd_toStartOf="@+id/imgCart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:startIconDrawable="@drawable/searchicon"
            app:startIconTint="@color/colorOnSurfaceVariant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingVertical="@dimen/space_md"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cart Button -->
        <ImageButton
            android:id="@+id/imgCart"
            style="@style/Widget.ECommerce.IconButton.Circle"
            android:src="@drawable/cart_icon"
            app:tint="@color/colorPrimary"
            android:contentDescription="@string/desc_cart_icon"
            app:layout_constraintBottom_toBottomOf="@+id/tilSearch"
            app:layout_constraintEnd_toStartOf="@+id/imgLogout"
            app:layout_constraintTop_toTopOf="@+id/tilSearch" />

        <!-- Sign out Button -->
        <ImageButton
            android:id="@+id/imgLogout"
            style="@style/Widget.ECommerce.IconButton.Circle"
            android:src="@drawable/ic_logout"
            app:tint="@color/colorOnSurfaceVariant"
            android:contentDescription="@string/desc_logout"
            app:layout_constraintBottom_toBottomOf="@+id/tilSearch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tilSearch" />

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilSearch" />

        <!-- Error State Layout -->
        <include
            android:id="@+id/layoutError"
            layout="@layout/view_error_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tilSearch" />

        <!-- Content Group Container -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="txtCategories,btnViewAllCategories,categoryCarousel,txtBrands,btnViewAllBrands,rv_brands,txtLatesProducts,rv_latestProducts" />

        <!-- Section: Categories -->
        <TextView
            android:id="@+id/txtCategories"
            style="@style/TextAppearance.ECommerce.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/section_categories"
            app:layout_constraintEnd_toStartOf="@+id/btnViewAllCategories"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilSearch" />

        <TextView
            android:id="@+id/btnViewAllCategories"
            style="@style/TextAppearance.ECommerce.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center_vertical"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:text="@string/action_view_all"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtCategories"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/categoryCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtCategories">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpCategories"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_carousel_height"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnCategoryPrev"
                style="@style/Widget.ECommerce.IconButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_carousel_button"
                android:contentDescription="@string/desc_previous_category"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_carousel_prev"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/vpCategories"
                app:layout_constraintStart_toStartOf="@+id/vpCategories"
                app:layout_constraintTop_toTopOf="@+id/vpCategories"
                app:tint="@color/carouselOnImage" />

            <ImageButton
                android:id="@+id/btnCategoryNext"
                style="@style/Widget.ECommerce.IconButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_carousel_button"
                android:contentDescription="@string/desc_next_category"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_carousel_next"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/vpCategories"
                app:layout_constraintEnd_toEndOf="@+id/vpCategories"
                app:layout_constraintTop_toTopOf="@+id/vpCategories"
                app:tint="@color/carouselOnImage" />

            <LinearLayout
                android:id="@+id/indicatorCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vpCategories" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Section: Brands -->
        <TextView
            android:id="@+id/txtBrands"
            style="@style/TextAppearance.ECommerce.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/section_brands"
            app:layout_constraintEnd_toStartOf="@+id/btnViewAllBrands"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/categoryCarousel" />

        <TextView
            android:id="@+id/btnViewAllBrands"
            style="@style/TextAppearance.ECommerce.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center_vertical"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:text="@string/action_view_all"
            app:layout_constraintBaseline_toBaselineOf="@+id/txtBrands"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_brands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtBrands"
            tools:listitem="@layout/brand_item" />

        <!-- Section: Latest Products -->
        <TextView
            android:id="@+id/txtLatesProducts"
            style="@style/TextAppearance.ECommerce.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/section_latest_products"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_brands" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_latestProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtLatesProducts"
            tools:listitem="@layout/product_item" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
