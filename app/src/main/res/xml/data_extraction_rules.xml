<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+.
   The auth token preference file is excluded from both cloud backup and
   device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_pref.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_pref.xml" />
    </device-transfer>
</data-extraction-rules>
