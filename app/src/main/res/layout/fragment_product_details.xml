<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".presentation.products.ProductDetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xxl">

        <!-- Top Navigation Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.ECommerce.IconButton.Circle"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/colorOnSurface"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                style="@style/TextAppearance.ECommerce.TitleMedium"
                android:text="@string/product_details_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnFavorite"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnFavorite"
                style="@style/Widget.ECommerce.IconButton.Circle"
                android:contentDescription="@string/desc_favorite_button"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Product Image Slider Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ECommerce.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/productImageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/product_detail_image_height"
                    android:background="@color/inputBackgroundColor" />

                <!-- Dots Indicator -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/imageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/space_xs"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabBackground="@drawable/tab_background_selector"
                    app:tabRippleColor="@null"
                    android:background="@android:color/transparent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Title -->
        <TextView
            android:id="@+id/tvProductTitle"
            style="@style/TextAppearance.ECommerce.TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            tools:text="Modern Wireless Headphones with Noise Cancellation" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvBrand"
            style="@style/TextAppearance.ECommerce.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            tools:text="Sony" />

        <!-- Rating Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/desc_rating_star"
                app:srcCompat="@drawable/ic_star_filled"
                app:tint="@color/ratingStarColor" />

            <TextView
                android:id="@+id/tvRating"
                style="@style/TextAppearance.ECommerce.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:textStyle="bold"
                tools:text="4.8" />

            <TextView
                android:id="@+id/tvReviewsCount"
                style="@style/TextAppearance.ECommerce.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="(128 reviews)" />

        </LinearLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice"
            style="@style/TextAppearance.ECommerce.Price.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            tools:text="149 EGP" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            style="@style/TextAppearance.ECommerce.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:lineSpacingExtra="4dp"
            tools:text="Experience crystal clear sound with deep bass and active noise cancellation. Long lasting battery life up to 30 hours." />

        <!-- Product Information Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ECommerce.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            app:cardElevation="@dimen/elevation_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/TextAppearance.ECommerce.TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/product_information" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_sm"
                    android:background="@color/dividerColor" />

                <TextView
                    android:id="@+id/tvCategory"
                    style="@style/TextAppearance.ECommerce.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Category: Electronics" />

                <TextView
                    android:id="@+id/tvSubCategory"
                    style="@style/TextAppearance.ECommerce.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    tools:text="Subcategory: Audio" />

                <TextView
                    android:id="@+id/tvStock"
                    style="@style/TextAppearance.ECommerce.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    tools:text="Available: 45" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quantity Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.ECommerce.TitleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quantity_label" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="@drawable/bg_quantity_container"
                android:padding="@dimen/space_xxs"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="@dimen/icon_button_size_small"
                    android:layout_height="@dimen/icon_button_size_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/colorOnSurfaceVariant"
                    android:contentDescription="@string/desc_decrease_quantity" />

                <TextView
                    android:id="@+id/tvQuantity"
                    style="@style/TextAppearance.ECommerce.TitleSmall"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    tools:text="1" />

                <ImageButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="@dimen/icon_button_size_small"
                    android:layout_height="@dimen/icon_button_size_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_add"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="@string/desc_increase_quantity" />

            </LinearLayout>

        </LinearLayout>

        <!-- Add To Cart Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            style="@style/Widget.ECommerce.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/action_add_to_cart" />

        <!-- Reviews Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.ECommerce.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_reviews" />

            <TextView
                android:id="@+id/tvRatingsQuantity"
                style="@style/TextAppearance.ECommerce.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="37 ratings" />

        </LinearLayout>

        <!-- Rating Summary Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ECommerce.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardElevation="@dimen/elevation_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReviewsRating"
                    style="@style/TextAppearance.ECommerce.HeadlineLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    tools:text="4.8" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/star1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/desc_rating_star"
                            app:srcCompat="@drawable/ic_star_filled"
                            app:tint="@color/ratingStarColor" />
                        <ImageView
                            android:id="@+id/star2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/desc_rating_star"
                            app:srcCompat="@drawable/ic_star_filled"
                            app:tint="@color/ratingStarColor" />
                        <ImageView
                            android:id="@+id/star3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/desc_rating_star"
                            app:srcCompat="@drawable/ic_star_filled"
                            app:tint="@color/ratingStarColor" />
                        <ImageView
                            android:id="@+id/star4"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/desc_rating_star"
                            app:srcCompat="@drawable/ic_star_filled"
                            app:tint="@color/ratingStarColor" />
                        <ImageView
                            android:id="@+id/star5"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/desc_rating_star"
                            app:srcCompat="@drawable/ic_star_filled"
                            app:tint="@color/ratingStarColor" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.ECommerce.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/rating_summary" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reviews RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            tools:listitem="@layout/item_review" />

        <!-- View All Reviews Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_all_reviews"
            style="@style/Widget.ECommerce.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/action_view_all_reviews"
            android:visibility="gone" />

        <!-- Similar Products Section -->
        <TextView
            style="@style/TextAppearance.ECommerce.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/section_similar_products" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSimilarProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="horizontal"
            tools:listitem="@layout/product_item" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
